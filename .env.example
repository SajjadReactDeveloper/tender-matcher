# Neon connection string (use a Neon dev branch locally)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 32+ random characters; signs the login cookie
SESSION_SECRET=

# The one fixed login. Create the hash with: npx tsx scripts/hash-password.ts "your password"  (looks like scrypt:16384:...)
APP_EMAIL=you@example.com
APP_PASSWORD_HASH=

# AI provider: groq (default) | openai | anthropic
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
TEXT_MODEL=
VISION_MODEL=
